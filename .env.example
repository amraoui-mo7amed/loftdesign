# App Core Settings
APP_SECRET=django-insecure-generate-a-real-one-for-production
APP_ENV=development # development or production
APP_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
DB_NAME=loftdesign
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Postgres Docker image expects these (loaded from env_file)
POSTGRES_DB=loftdesign
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
# Docker Settings
COMPOSE_FILE=docker-compose.dev.yml
# EMAIL Settings
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# CSRF_TRUSTED_ORIGINS
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# ADMIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword
ADMIN_EMAIL=admin@example.com
